%== Champs d entete ==%
%%numero
\def\evalnumber#1{\def\@evalnumber{#1}}
\evalnumber{}
%%eval type
\def\evaltype#1{\def\@evaltype{#1}}
\evaltype{Evaluation}
%%titre
\def\titre#1{\def\@titre{#1}}
\titre{}
%%classe/groupe
\def\classe#1{\def\@classe{#1}}
\classe{}
%%date
\def\date#1{\def\@date{#1}}
\classe{}
%%Annee scolaire
\def\annee#1{\def\@annee{#1}}
\annee{
	\ifnum\month>8 % If month > August (September to December)
		\the\year \ - \the\numexpr\year+1\relax % Current year
	\else % If month <= August (January to August)
		\the\numexpr\year-1\relax \ - \the\year % Previous year
	\fi
}
%% sujet différenciés
\newif\if@sujetB
\@sujetBtrue % Default value: \@sujetB is true
\DeclareOption{noSujetB}{\@sujetBfalse}
\ProcessOptions

% font
% **********************
\fontfamily{lmss}\selectfont
\renewcommand{\labelitemi}{$\star$}
\DeclareTextFontCommand{\myfont}{\fontfamily{lmss}\selectfont}

% Numérotation des pages 
% **********************
\pagenumbering{arabic}
\ifodd\thepage\else\thispagestyle{empty}\hbox{}\newpage\fi%si page paire ou impaire


% Header
% ***************
\pagestyle{fancy}
\fancyhf{}                       % on annule le fancy automatique
\renewcommand\headrulewidth{1pt}
\renewcommand\footrulewidth{1pt}
\fancyhf[L]{\@classe}
\fancyhf[C]{\@evaltype\ \@evalnumber: \@titre}
\fancyhf[R]{\@date}

% Footer 
% **********************
\renewcommand\footrulewidth{1pt}

\if@sujetB
	\fancyfoot[RO]{sujet A}
	\fancyfoot[RE]{sujet B}
\else
	\fancyfoot[R]{\thepage/\lastpageref{VeryLastPage}}
\fi

\fancyfoot[L]{\myfont{PE BAVIERE - Lycée J. Vernes}}
\fancyfoot[C]{}

